{
  "name": "Falcon West Material",
  "version": "claude-lock",
  "scope": "apps, CRM, Tools, Academy gates, and serial team products only. Not falconwest.com. Not falconwestenergy.com.",
  "source": "Claude Falcon West Material pack roles — hex values are the existing house palette, not new tokens.",
  "color": {
    "ink": { "token": "ink-900", "value": "#080808", "role": "Text base. Never #000000 for body/ink." },
    "paper": { "token": "paper-50", "value": "#fcfefe", "role": "Page background (--md-background)." },
    "surface": { "token": "white", "value": "#ffffff", "role": "Card / surface (--md-surface)." },
    "roles": {
      "md-primary": {
        "token": "rust-700",
        "value": "#a85f2e",
        "role": "Primary action. Only rust legal on a text-bearing fill."
      },
      "md-primary-variant": {
        "token": "rust-800",
        "value": "#8a4d25",
        "role": "Primary hover / darker rust."
      },
      "md-primary-decorative": {
        "token": "rust-600",
        "value": "#D2793D",
        "role": "Logo orange. Decorative fill only — never text, never a labeled button."
      },
      "md-on-primary": { "value": "#ffffff" },
      "md-secondary": {
        "token": "navy-900",
        "value": "#15445D",
        "role": "Chrome only: app bar, dark surfaces, focus ring. Never a button fill."
      },
      "md-on-secondary": { "value": "#ffffff" },
      "md-link": {
        "token": "sky-600",
        "value": "#2d78ad",
        "role": "Text hyperlink default."
      },
      "md-link-hover": {
        "token": "sky-700",
        "value": "#266690",
        "role": "Link hover. Sky stays sky — never rust, never navy."
      }
    }
  },
  "shape": {
    "shape-large": {
      "value": "0px",
      "applies": ["cards", "modals", "app-bar", "alerts", "banners"]
    },
    "shape-small": {
      "value": "4px",
      "applies": ["buttons", "inputs", "selects", "controls"]
    },
    "shape-pill": {
      "value": "999px",
      "applies": ["chips", "badges", "extended-fab", "switch-track"]
    },
    "shape-circle": {
      "value": "50%",
      "applies": ["radio", "fab", "state-layer-haloes"]
    }
  },
  "elevation": {
    "card": 1,
    "contained-button": 2,
    "contained-button-hover": 4,
    "app-bar": 4,
    "fab": 6,
    "fab-hover": 8,
    "menu": 8,
    "dialog": 24
  },
  "focus": {
    "width": "2px",
    "offset": "2px",
    "color": "#15445D",
    "color-on-dark": "#ffffff",
    "css": "outline: 2px solid #15445D; outline-offset: 2px;",
    "exception": "Text fields use a 2px rust-700 border instead of the navy ring."
  },
  "rules": [
    "Navy is chrome, never a button fill.",
    "Cards are square (shape-large 0). Do not use 4px on cards.",
    "Menus sit at elevation-8.",
    "Links are sky in both rest and hover.",
    "Ink is #080808. Paper is #fcfefe."
  ]
}
